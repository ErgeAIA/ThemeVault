{
  "version": 1,
  "description": "Nord L1 semantic role set (named 16-color palette mapped to L1 roles). required = the 29 standard L1 roles; derivedOptional = roles the VS Code port explicitly defines (status fills, shadow, sidebar, selection, diff). Accent = --nord8 (#88c0d0), the official 'accent color of the palette'.",
  "required": [
    "bg",
    "bg-surface",
    "bg-surface-2",
    "bg-elevated",
    "bg-hover",
    "text",
    "text-muted",
    "text-dim",
    "border",
    "border-strong",
    "border-focus",
    "card",
    "hairline",
    "accent",
    "accent-hover",
    "accent-deep",
    "accent-secondary",
    "accent-foreground",
    "ok",
    "warn",
    "danger",
    "info",
    "queued",
    "syntax-comment",
    "syntax-keyword",
    "syntax-string",
    "syntax-literal",
    "syntax-title",
    "syntax-attr"
  ],
  "derivedOptional": [
    "ok-fill",
    "warn-fill",
    "danger-fill",
    "info-fill",
    "queued-fill",
    "shadow",
    "sidebar-bg",
    "text-secondary",
    "selection",
    "diff-insert",
    "diff-remove"
  ]
}
