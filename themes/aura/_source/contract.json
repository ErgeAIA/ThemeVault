{
  "family": "aura",
  "version": 1,
  "source": {
    "project": "aura-theme",
    "repo": "https://github.com/daltonmenezes/aura-theme",
    "license": "MIT",
    "ref": "main (2026-08)",
    "primarySource": "src/core/colors/schemes/{dark,soft-dark,common}.ts + packages/vscode/themes/aura-{dark,soft-dark}-color-theme.json"
  },
  "required": [
    "bg",
    "bg-surface",
    "bg-surface-2",
    "bg-elevated",
    "bg-hover",
    "text",
    "text-muted",
    "text-dim",
    "border",
    "border-strong",
    "border-focus",
    "card",
    "hairline",
    "accent",
    "accent-hover",
    "accent-deep",
    "accent-secondary",
    "accent-foreground",
    "ok",
    "warn",
    "danger",
    "info",
    "queued",
    "syntax-comment",
    "syntax-keyword",
    "syntax-string",
    "syntax-literal",
    "syntax-title",
    "syntax-attr"
  ],
  "derivedOptional": [
    "ok-fill",
    "warn-fill",
    "danger-fill",
    "info-fill",
    "queued-fill",
    "shadow",
    "selection",
    "selection-solid",
    "placeholder",
    "diff-insert",
    "diff-remove",
    "statusbar-foreground",
    "activitybar-inactive"
  ]
}
